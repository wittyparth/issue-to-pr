# Copy to .env for local development. NEVER commit real secrets.
# In AWS these resolve from Secrets Manager, not env files.

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
GH_WEBHOOK_SECRET=

# LLM providers (any one; OpenRouter is the default multiplexer)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# AWS (local synth/deploy)
CDK_DEFAULT_REGION=us-east-1
